
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Prueba de conexión Motum - Supabase</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f3f5f8;
      margin: 0;
      padding: 35px 16px;
      color: #172b4d;
    }
    main {
      max-width: 560px;
      margin: auto;
      background: white;
      padding: 28px;
      border-radius: 12px;
      box-shadow: 0 4px 20px #00000012;
    }
    h2 { margin-top: 0; }
    button {
      padding: 12px 18px;
      border: 0;
      border-radius: 7px;
      cursor: pointer;
      margin: 8px 5px 8px 0;
      background: #173e70;
      color: white;
      font-weight: bold;
    }
    button:disabled { opacity: .5; cursor: wait; }
    #resultado {
      margin-top: 20px;
      padding: 15px;
      background: #f3f5f8;
      border-radius: 8px;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      line-height: 1.6;
    }
    .nota { color: #596579; font-size: 14px; }
  </style>
</head>
<body>
<main>
  <h2>Motum | Prueba de conexión Supabase</h2>
  <p class="nota">
    Esta página valida el acceso con Google y la creación del perfil.
    No modifica el portal principal.
  </p>

  <button id="login">Continuar con Google</button>
  <button id="logout" hidden>Cerrar sesión de prueba</button>
  <div id="resultado">Esperando una prueba de acceso...</div>
</main>

<script>
(async function () {
  const SUPABASE_URL = 'https://zxkmxtthgvwzrqpmfaso.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_DiE3bATktxW8hSniZbYjYg_cBgYITX6';
  const DOMAIN = 'tecnomotum.com';

  const client = window.supabase.createClient(
    SUPABASE_URL,
    SUPABASE_KEY,
    {
      auth: {
        persistSession: true,
        autoRefreshToken: true,
        detectSessionInUrl: true
      }
    }
  );

  const result = document.getElementById('resultado');
  const login = document.getElementById('login');
  const logout = document.getElementById('logout');
  let checking = false;

  function show(message) {
    result.textContent = message;
  }

  async function inspectSession(session) {
    if (!session || !session.user || checking) return;
    checking = true;
    login.hidden = true;
    logout.hidden = false;

    try {
      const user = session.user;
      const email = String(user.email || '').toLowerCase();

      if (!email.endsWith('@' + DOMAIN)) {
        show('ERROR: el correo no pertenece al dominio autorizado @' + DOMAIN + '.');
        return;
      }

      show('Google: acceso correcto.\nComprobando perfil en la base de datos...');

      let profile = null;
      let profileError = null;

      for (let attempt = 0; attempt < 8; attempt++) {
        const response = await client
          .from('perfiles')
          .select('id,nombre_completo,correo,activo')
          .eq('id', user.id)
          .maybeSingle();

        profile = response.data;
        profileError = response.error;

        if (profile || profileError) break;
        await new Promise(resolve => setTimeout(resolve, 500));
      }

      if (profileError) {
        show(
          'GOOGLE: CORRECTO\n' +
          'BASE DE DATOS: ERROR AL CONSULTAR EL PERFIL\n\n' +
          profileError.message
        );
        return;
      }

      if (!profile) {
        show(
          'GOOGLE: CORRECTO\n' +
          'PERFIL: NO ENCONTRADO\n\n' +
          'La cuenta se autenticó, pero no se encontró su registro en perfiles. ' +
          'No continúes con la asignación de Administrador hasta revisar el trigger.'
        );
        return;
      }

      const { data: roles, error: roleError } = await client
        .from('usuario_roles')
        .select('rol_id')
        .eq('usuario_id', user.id);

      if (roleError) {
        show(
          'GOOGLE: CORRECTO\n' +
          'PERFIL: ENCONTRADO\n' +
          'ROLES: ERROR DE CONSULTA\n\n' +
          roleError.message
        );
        return;
      }

      show(
        'RESULTADO DE LA PRUEBA\n\n' +
        'Google: CORRECTO\n' +
        'Perfil en Supabase: ENCONTRADO\n' +
        'Cuenta activa: ' + (profile.activo ? 'SÍ' : 'NO') + '\n' +
        'Roles asignados: ' + (roles ? roles.length : 0) + '\n\n' +
        'Nombre: ' + (profile.nombre_completo || 'Sin nombre') + '\n' +
        'Correo: ' + profile.correo + '\n' +
        'UUID: ' + user.id + '\n\n' +
        (roles && roles.length
          ? 'La cuenta ya tiene al menos un rol asignado.'
          : 'La cuenta todavía no tiene rol. El siguiente paso será asignar Administrador.')
      );
    } catch (error) {
      show('ERROR DURANTE LA PRUEBA:\n' + error.message);
    } finally {
      checking = false;
    }
  }

  login.addEventListener('click', async () => {
    login.disabled = true;
    show('Conectando con Google...');

    const redirectTo = window.location.href.split('#')[0].split('?')[0];

    const { error } = await client.auth.signInWithOAuth({
      provider: 'google',
      options: {
        redirectTo,
        queryParams: {
          hd: DOMAIN,
          prompt: 'select_account'
        }
      }
    });

    if (error) {
      show('No fue posible iniciar sesión:\n' + error.message);
      login.disabled = false;
    }
  });

  logout.addEventListener('click', async () => {
    await client.auth.signOut();
    login.hidden = false;
    logout.hidden = true;
    login.disabled = false;
    show('Sesión cerrada. Puedes realizar otra prueba.');
  });

  const { data, error } = await client.auth.getSession();

  if (error) {
    show('No se pudo recuperar la sesión:\n' + error.message);
    return;
  }

  if (data.session) {
    await inspectSession(data.session);
  }

  client.auth.onAuthStateChange((event, session) => {
    if (session && ['SIGNED_IN', 'INITIAL_SESSION', 'TOKEN_REFRESHED'].includes(event)) {
      setTimeout(() => inspectSession(session), 0);
    }
  });
})();
</script>
</body>
</html>
